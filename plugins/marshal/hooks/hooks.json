{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/cli.js",
              "hook",
              "--source",
              "claude"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/cli.js",
              "hook",
              "--source",
              "claude"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/cli.js",
              "hook",
              "--source",
              "claude",
              "--event",
              "PreToolUse"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/cli.js",
              "hook",
              "--source",
              "claude"
            ]
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/cli.js",
              "hook",
              "--source",
              "claude"
            ]
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/cli.js",
              "hook",
              "--source",
              "claude"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "async": true,
            "asyncRewake": true,
            "timeout": 900,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/cli.js",
              "hook",
              "--source",
              "claude",
              "--event",
              "Stop",
              "--listen"
            ]
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/cli.js",
              "hook",
              "--source",
              "claude"
            ]
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/cli.js",
              "hook",
              "--source",
              "claude"
            ]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/cli.js",
              "hook",
              "--source",
              "claude"
            ]
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/cli.js",
              "hook",
              "--source",
              "claude"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/cli.js",
              "hook",
              "--source",
              "claude"
            ]
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 120,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/cli.js",
              "hook",
              "--source",
              "claude",
              "--event",
              "PermissionRequest"
            ]
          }
        ]
      }
    ]
  }
}
